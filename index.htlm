
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ONLINE TRPG</title>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>

<style>
*{box-sizing:border-box}
body{margin:0;background:#111827;color:#e5e7eb;font-family:Arial,'Malgun Gothic',sans-serif}
button,input,select{font:inherit}
button{border:0;border-radius:8px;padding:10px 14px;background:#2563eb;color:white;cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
.secondary{background:#374151}
.danger{background:#b91c1c}
.green{background:#15803d}
.hidden{display:none!important}
.wrap{max-width:1200px;margin:auto;padding:18px}
.panel{background:#1f2937;border:1px solid #374151;border-radius:12px;padding:15px;margin-bottom:14px}
.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.grow{flex:1}
.muted{color:#9ca3af;font-size:13px}
input,select{background:#111827;color:#f9fafb;border:1px solid #4b5563;border-radius:8px;padding:10px;max-width:100%}
h1,h2,h3{margin:0 0 12px}
h1{letter-spacing:2px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.players{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.player{background:#111827;border:1px solid #4b5563;border-radius:10px;padding:10px;cursor:pointer;text-align:center}
.player .avatar{font-size:28px}
.player.active{border-color:#60a5fa}
.player.gm{box-shadow:inset 0 0 0 1px #eab308}
.chatlog{height:330px;overflow:auto;background:#0b1220;border-radius:9px;padding:10px}
.msg{padding:8px 9px;border-bottom:1px solid #263244;white-space:pre-wrap;overflow-wrap:anywhere}
.msg .meta{font-size:12px;color:#9ca3af;margin-bottom:4px}
.msg.narration{border-left:3px solid #eab308}
.msg.speech{border-left:3px solid #60a5fa}
.msg.skill{border-left:3px solid #a78bfa}
.msg.item{border-left:3px solid #34d399}
.msg.system{color:#a7f3d0}
.small{font-size:12px}
.tag{display:inline-block;background:#374151;padding:3px 7px;border-radius:20px;font-size:12px;margin:2px}
.top{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:14px}
.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.statgrid label{font-size:12px;color:#9ca3af}
.statgrid input{width:100%}
.skillrow{display:grid;grid-template-columns:1.2fr 1fr;gap:8px;margin:6px 0}
.help{line-height:1.6;color:#cbd5e1;font-size:13px}
.status{color:#86efac}
.warn{color:#fca5a5}

@media(max-width:650px){
.wrap{padding:10px}
.grid,.players{grid-template-columns:1fr 1fr}
.chatlog{height:300px}
.statgrid{grid-template-columns:repeat(2,1fr)}
.top{align-items:flex-start;flex-direction:column}
}
</style>
</head>

<body>
<div class="wrap">

<header class="top">
<div>
<h1>ONLINE TRPG</h1>
<div class="muted">D20 판정 · 실시간 방 · 최대 4명</div>
</div>
<div id="authStatus" class="muted">Firebase 연결 중...</div>
</header>

<section id="lobby">

<div class="panel">
<h2>방 만들기</h2>
<div class="row">
<input id="createName" placeholder="캐릭터 이름" maxlength="16">
<input id="createRace" placeholder="종족 (예: 인간)" maxlength="16">
<button id="createBtn">방 만들기</button>
</div>
<p class="help">
방을 만든 사람이 방장이 됩니다.
방장은 참가자 중 한 명을 GM으로 지정할 수 있으며,
자기 자신도 GM으로 지정할 수 있습니다.
</p>
</div>

<div class="panel">
<h2>방 참가</h2>
<div class="row">
<input id="joinCode" placeholder="방 코드" maxlength="8" style="text-transform:uppercase">
<input id="joinName" placeholder="캐릭터 이름" maxlength="16">
<input id="joinRace" placeholder="종족" maxlength="16">
<button id="joinBtn">참가하기</button>
</div>
</div>

<div id="lobbyError" class="warn"></div>
</section>

<section id="game" class="hidden">

<div class="top">
<div>
<h2>방 코드: <span id="roomCodeLabel"></span></h2>
<div id="roomInfo" class="muted"></div>
</div>
<div class="row">
<button id="copyCode" class="secondary">코드 복사</button>
<button id="leaveBtn" class="danger">나가기</button>
</div>
</div>

<div class="grid">

<div>
<div class="panel">
<div class="row" style="justify-content:space-between">
<h3>플레이어</h3>
<span class="muted" id="playerCount"></span>
</div>
<div class="players" id="playerSeats"></div>
<p class="muted">플레이어 아이콘을 누르면 상태창을 확인할 수 있습니다.</p>
</div>

<div class="panel">
<h3>상태창</h3>
<div id="statusPanel" class="help">
플레이어 아이콘을 선택하세요.
</div>
</div>

<div class="panel" id="gmPanel">
<h3>GM 관리</h3>
<div id="gmControls"></div>
</div>
</div>

<div>
<div class="panel">
<div class="row" style="justify-content:space-between">
<h3>진행 채팅</h3>
<span id="turnLabel" class="tag">대기 중</span>
</div>

<div id="chatlog" class="chatlog"></div>

<div class="row" style="margin-top:9px">
<input id="chatInput" class="grow"
placeholder='"대사" / \'진행 대사\' / //스킬 / (아이템)'
maxlength="500">
<button id="sendBtn">전송</button>
</div>

<div class="help">
"대사" = 캐릭터 대사 ·
'대사' = 일반/진행 대사 ·
 //스킬명 = 스킬 사용 ·
(아이템명) = 아이템 사용
</div>
</div>

<div class="panel">
<h3>D20 판정</h3>
<div id="rollInfo" class="help">
GM이 판정할 플레이어를 지정하면 해당 플레이어만 주사위를 굴릴 수 있습니다.
</div>

<div class="row">
<select id="rollStat">
<option value="str">힘</option>
<option value="dex">민첩</option>
<option value="int">지능</option>
<option value="con">체력</option>
<option value="wis">지혜</option>
<option value="cha">매력</option>
</select>
<button id="rollBtn" class="green" disabled>D20 굴리기</button>
</div>
</div>
</div>
</div>
</section>
</div>

<script>

// Firebase Console > 프로젝트 설정 > 내 앱에서 발급한 실제 설정값으로 교체하세요.

const firebaseConfig = {
  apiKey: "여기에_API_KEY",
  authDomain: "여기에_PROJECT_ID.firebaseapp.com",
  databaseURL: "https://여기에_DATABASE_NAME.asia-southeast1.firebasedatabase.app",
  projectId: "여기에_PROJECT_ID",
  appId: "여기에_APP_ID"
};

const $=id=>document.getElementById(id);

const STAT_NAMES={
str:'힘',
dex:'민첩',
int:'지능',
con:'체력',
wis:'지혜',
cha:'매력'
};

let db,uid,roomId,roomRef,roomData=null,me=null,selectedUid=null,unsubs=[];

function err(s){
$('lobbyError').textContent=s;
}

function isHost(){
return !!roomData&&roomData.hostUid===uid;
}

function isGM(){
return !!roomData&&roomData.gmUid===uid;
}

function playerList(){
return Object.values(roomData?.players||{})
.sort((a,b)=>(a.joinedAt||0)-(b.joinedAt||0));
}

function myPlayer(){
return roomData?.players?.[uid];
}

function cleanName(s){
return (s||'').trim().slice(0,16);
}

function systemMsg(text){
return roomRef.child('messages').push({
type:'system',
text,
by:'SYSTEM',
at:Date.now()
});
}

function showGame(){
$('lobby').classList.add('hidden');
$('game').classList.remove('hidden');
$('roomCodeLabel').textContent=roomId;
}

function showLobby(){
$('game').classList.add('hidden');
$('lobby').classList.remove('hidden');
}

async function init(){
try{
firebase.initializeApp(firebaseConfig);
db=firebase.database();

const cred=await firebase.auth().signInAnonymously();
uid=cred.user.uid;

$('authStatus').textContent='Firebase 로그인 완료';
$('authStatus').className='status';

}catch(e){
$('authStatus').textContent='Firebase 오류: '+e.message;
$('authStatus').className='warn';
$('lobbyError').textContent=
'Firebase 설정 또는 익명 로그인 설정을 확인하세요. '+e.message;
}
}

function makePlayer(name,race){
return {
uid,
name,
race:race||'미정',
avatar:'🧙',
joinedAt:Date.now(),
hp:30,
maxHp:30,
stats:{
str:10,
dex:10,
int:10,
con:10,
wis:10,
cha:10
},
skills:[],
items:[]
};
}

function randomCode(){
return Math.random().toString(36).slice(2,7).toUpperCase();
}

$('createBtn').onclick=async()=>{
if(!db||!uid)return;

const name=cleanName($('createName').value);

if(!name){
err('캐릭터 이름을 입력하세요.');
return;
}

err('');

for(let i=0;i<5;i++){
const code=randomCode();
const ref=db.ref('trpgRooms/'+code);

try{
const p=makePlayer(name,$('createRace').value.trim());

await ref.transaction(cur=>
cur===null?{
hostUid:uid,
gmUid:uid,
status:'waiting',
createdAt:Date.now(),
players:{[uid]:p},
messages:{},
turn:{
active:false,
number:0,
rollTarget:null,
rollUsed:false
}
}:undefined
);

const snap=await ref.once('value');

if(snap.exists()&&snap.val().hostUid===uid){
enterRoom(code);
return;
}

}catch(e){
err('방 생성 실패: '+e.message);
return;
}
}

err('방 코드 생성에 실패했습니다. 다시 시도하세요.');
};

$('joinBtn').onclick=async()=>{
if(!db||!uid)return;

const code=$('joinCode').value.trim().toUpperCase();
const name=cleanName($('joinName').value);

if(!code||!name){
err('방 코드와 캐릭터 이름을 입력하세요.');
return;
}

err('');

const ref=db.ref('trpgRooms/'+code);

try{
const result=await ref.transaction(r=>{
if(
!r||
r.status!=='waiting'||
Object.keys(r.players||{}).length>=4||
r.players?.[uid]
)return;

r.players=r.players||{};
r.players[uid]=makePlayer(name,$('joinRace').value.trim());

return r;
});

if(!result.committed){
err('방이 없거나 게임이 시작되었거나 인원이 가득 찼습니다.');
return;
}

enterRoom(code);

}catch(e){
err('방 참가 실패: '+e.message);
}
};

function enterRoom(code){
roomId=code;
roomRef=db.ref('trpgRooms/'+code);
showGame();

roomRef.on('value',snap=>{
if(!snap.exists()){
alert('방이 삭제되었습니다.');
cleanup();
return;
}

roomData=snap.val();
me=myPlayer();
render();
});

roomRef.child('messages').limitToLast(150).on('child_added',snap=>{
renderMessages();
});

unsubs.push(()=>roomRef.off());
}

function cleanup(){
unsubs.forEach(f=>f());
unsubs=[];
roomId=null;
roomData=null;
showLobby();
}

$('leaveBtn').onclick=async()=>{
if(!roomRef||!uid)return;

if(isHost()){
if(confirm('방장이 나가면 방이 삭제됩니다. 나갈까요?'))
await roomRef.remove();
}else{
await roomRef.child('players/'+uid).remove();
}

cleanup();
};

$('copyCode').onclick=()=>{
navigator.clipboard?.writeText(roomId);
};

function render(){
if(!roomData)return;

$('roomInfo').textContent=
(roomData.status==='playing'?'게임 진행 중':'대기실')+
' · '+(isHost()?'방장':'참가자')+
(isGM()?' · GM':'');

$('playerCount').textContent=playerList().length+'/4명';

$('turnLabel').textContent=
roomData.turn?.active?
'턴 '+roomData.turn.number+' 진행 중':
'턴 대기';

renderSeats();
renderStatus();
renderGM();
renderRoll();
}

function renderSeats(){
const box=$('playerSeats');
box.innerHTML='';

playerList().forEach(p=>{
const b=document.createElement('button');

b.className='player'+
(p.uid===selectedUid?' active':'')+
(p.uid===roomData.gmUid?' gm':'');

b.innerHTML=`
<div class="avatar">${p.avatar||'👤'}</div>
<b></b>
<div class="small"></div>
`;

b.querySelector('b').textContent=
p.name+(p.uid===roomData.gmUid?' · GM':'');

b.querySelector('.small').textContent=
`HP ${p.hp}/${p.maxHp}`;

b.onclick=()=>{
selectedUid=p.uid;
renderSeats();
renderStatus();
};

box.appendChild(b);
});
}

function renderStatus(){
const p=roomData.players?.[selectedUid||uid];

if(!p){
$('statusPanel').textContent='플레이어 아이콘을 선택하세요.';
return;
}

const s=p.stats||{};

$('statusPanel').innerHTML='';

const title=document.createElement('div');

title.innerHTML=
`<b>${p.name}</b> <span class="tag">${p.race||'종족 미정'}</span>`;

$('statusPanel').append(title);

const hp=document.createElement('p');
hp.textContent=`HP ${p.hp}/${p.maxHp}`;
$('statusPanel').append(hp);

const stats=document.createElement('div');
stats.className='statgrid';

Object.entries(STAT_NAMES).forEach(([k,n])=>{
const d=document.createElement('div');

d.innerHTML=`
<label>${n}</label>
<div>
<b>${Number(s[k]??10)}</b>
<span class="muted">
(보정 ${mod(s[k]??10)>=0?'+':''}${mod(s[k]??10)})
</span>
</div>
`;

stats.append(d);
});

$('statusPanel').append(stats);

const sk=document.createElement('p');

sk.innerHTML='<b>스킬</b><br>'+
(p.skills||[]).map(x=>
`<span class="tag">${escapeHtml(x.name)} · ${STAT_NAMES[x.stat]||x.stat}</span>`
).join('');

$('statusPanel').append(sk);

const it=document.createElement('p');

it.innerHTML='<b>아이템</b><br>'+
(p.items||[]).map(x=>
`<span class="tag">${escapeHtml(x)}</span>`
).join('');

$('statusPanel').append(it);

if((p.uid===uid||isGM())&&p.uid){
const btn=document.createElement('button');

btn.className='secondary';
btn.textContent=p.uid===uid?'내 캐릭터 수정':'GM: 캐릭터 수정';
btn.onclick=()=>editCharacter(p);

$('statusPanel').append(btn);
}
}

function mod(v){
return Math.floor((Number(v)-10)/2);
}

function escapeHtml(s){
return String(s??'').replace(/[&<>"']/g,c=>({
'&':'&amp;',
'<':'&lt;',
'>':'&gt;',
'"':'&quot;',
"'":'&#39;'
}[c]));
}

async function editCharacter(p){
const name=prompt('캐릭터 이름',p.name);
if(name===null)return;

const race=prompt('종족',p.race||'');
if(race===null)return;

const hp=Number(prompt('현재 HP',p.hp));
const maxHp=Number(prompt('최대 HP',p.maxHp));

const stats={};

for(const [k,n] of Object.entries(STAT_NAMES)){
const v=Number(prompt(n+' 능력치',p.stats?.[k]??10));
if(!Number.isFinite(v))return;
stats[k]=v;
}

const items=prompt(
'아이템을 쉼표로 구분해 입력',
(p.items||[]).join(',')
);

if(items===null)return;

const updates={
name:cleanName(name),
race,
hp:Number.isFinite(hp)?hp:p.hp,
maxHp:Number.isFinite(maxHp)?maxHp:p.maxHp,
stats,
items:items.split(',').map(x=>x.trim()).filter(Boolean)
};

if(!isGM()&&p.uid!==uid)return;

await roomRef.child('players/'+p.uid).update(updates);
}

function renderGM(){
const box=$('gmControls');
box.innerHTML='';

if(!isHost()&&!isGM()){
$('gmPanel').classList.add('hidden');
return;
}

$('gmPanel').classList.remove('hidden');

if(isHost()){
const lab=document.createElement('label');
lab.textContent='GM 지정 ';

const sel=document.createElement('select');
sel.id='gmSelect';

playerList().forEach(p=>{
const o=document.createElement('option');
o.value=p.uid;
o.textContent=p.name;
sel.append(o);
});

sel.value=roomData.gmUid||roomData.hostUid;

const set=document.createElement('button');
set.textContent='GM 지정';
set.onclick=()=>roomRef.update({gmUid:sel.value});

box.append(lab,sel,set);
}

if(isGM()){

const start=document.createElement('button');
start.className='green';
start.textContent=
roomData.status==='playing'?'게임 진행 중':'게임 시작';

start.disabled=roomData.status==='playing';

start.onclick=()=>roomRef.update({status:'playing'});

box.append(start);

const hr=document.createElement('hr');
hr.style.borderColor='#374151';
box.append(hr);

const target=document.createElement('select');
target.id='targetSelect';

playerList().forEach(p=>{
const o=document.createElement('option');
o.value=p.uid;
o.textContent=p.name;
target.append(o);
});

const grant=document.createElement('button');
grant.textContent='선택 플레이어에게 D20 권한';

grant.onclick=()=>{
roomRef.child('turn').update({
active:true,
number:(roomData.turn?.number||0)+1,
rollTarget:target.value,
rollUsed:false
});
};

box.append(
document.createTextNode('판정 대상: '),
target,
grant
);

const end=document.createElement('button');
end.className='danger';
end.textContent='턴 종료';
end.style.marginLeft='6px';

end.onclick=()=>roomRef.child('turn').update({
active:false,
rollTarget:null,
rollUsed:false
});

box.append(end);

const hr2=document.createElement('hr');
hr2.style.borderColor='#374151';
box.append(hr2);

const psel=document.createElement('select');
psel.id='skillPlayer';

playerList().forEach(p=>{
const o=document.createElement('option');
o.value=p.uid;
o.textContent=p.name;
psel.append(o);
});

box.append(
document.createTextNode('스킬 설정 대상: '),
psel
);

for(let i=0;i<4;i++){
const row=document.createElement('div');
row.className='skillrow';

const nm=document.createElement('input');
nm.placeholder=`스킬 ${i+1} 이름`;
nm.id='skillName'+i;

const st=document.createElement('select');
st.id='skillStat'+i;

Object.entries(STAT_NAMES).forEach(([k,n])=>{
const o=document.createElement('option');
o.value=k;
o.textContent=n;
st.append(o);
});

row.append(nm,st);
box.append(row);
}

const save=document.createElement('button');
save.textContent='스킬 4칸 저장';

save.onclick=async()=>{
const pid=psel.value;
const skills=[];

for(let i=0;i<4;i++){
const n=$('skillName'+i).value.trim();

if(n){
skills.push({
name:n,
stat:$('skillStat'+i).value
});
}
}

await roomRef.child('players/'+pid+'/skills').set(skills);

systemMsg(
`${roomData.players[pid].name}의 스킬 설정이 변경되었습니다.`
);
};

box.append(save);
}
}

function renderRoll(){
const t=roomData.turn||{};
const target=t.rollTarget?
roomData.players?.[t.rollTarget]:null;

$('rollInfo').textContent=
t.active?
(target?
`${target.name}에게 D20 판정 권한이 부여되었습니다.`:
'판정 대상이 없습니다.'):
'GM이 판정 권한을 부여할 때까지 기다리세요.';

$('rollBtn').disabled=!(
t.active&&
t.rollTarget===uid&&
!t.rollUsed
);
}

$('rollBtn').onclick=async()=>{
const t=roomData?.turn;

if(!t?.active||t.rollTarget!==uid||t.rollUsed)return;

const stat=$('rollStat').value;
const p=myPlayer();

const die=1+Math.floor(Math.random()*20);
const bonus=mod(p.stats?.[stat]??10);
const total=die+bonus;

const tx=await roomRef.child('turn').transaction(cur=>{
if(!cur||!cur.active||cur.rollTarget!==uid||cur.rollUsed)return;

cur.rollUsed=true;
return cur;
});

if(!tx.committed)return;

await roomRef.child('messages').push({
type:'system',
text:
`${p.name}의 D20 판정: ${die} + ${STAT_NAMES[stat]} 보정 ${bonus>=0?'+':''}${bonus} = ${total}`,
by:'SYSTEM',
at:Date.now()
});
};

$('sendBtn').onclick=sendChat;

$('chatInput').addEventListener('keydown',e=>{
if(e.key==='Enter')sendChat();
});

async function sendChat(){
const raw=$('chatInput').value.trim();

if(!raw||!roomData)return;

const p=myPlayer();
if(!p)return;

let type='chat';
let text=raw;
let skillName=null;
let itemName=null;

if(raw.startsWith('"')&&raw.endsWith('"')&&raw.length>=2){
type='speech';
text=raw.slice(1,-1);

}else if(raw.startsWith("'")&&raw.endsWith("'")&&raw.length>=2){
type='narration';
text=raw.slice(1,-1);

if(!isGM()){
alert("작은따옴표 진행 대사는 GM만 사용할 수 있습니다.");
return;
}

}else if(raw.startsWith('//')){
type='skill';
skillName=raw.slice(2).trim();

const skill=(p.skills||[]).find(x=>x.name===skillName);

if(!skill){
alert('GM이 설정한 스킬만 사용할 수 있습니다.');
return;
}

text=
`${p.name}이(가) 스킬 [${skill.name}]을(를) 사용합니다. (판정 능력치: ${STAT_NAMES[skill.stat]})`;

}else if(raw.startsWith('(')&&raw.endsWith(')')&&raw.length>=3){
type='item';
itemName=raw.slice(1,-1).trim();

if(!(p.items||[]).includes(itemName)){
alert('보유 아이템에 없는 이름입니다. 상태창에서 아이템을 확인하세요.');
return;
}

text=
`${p.name}이(가) 아이템 (${itemName})을(를) 사용합니다.`;

}else if(isGM()){
type='narration';

}else{
type='chat';
}

await roomRef.child('messages').push({
type,
text,
by:p.name,
uid,
at:Date.now()
});

$('chatInput').value='';
}

function renderMessages(){
if(!roomRef)return;

roomRef.child('messages').limitToLast(150).once('value',snap=>{
const log=$('chatlog');
log.innerHTML='';

snap.forEach(ch=>{
const m=ch.val();

const d=document.createElement('div');
d.className='msg '+(m.type||'chat');

const meta=document.createElement('div');
meta.className='meta';

meta.textContent=
(m.by||'알 수 없음')+
' · '+
new Date(m.at||Date.now()).toLocaleTimeString();

const body=document.createElement('div');
body.textContent=m.text||'';

d.append(meta,body);
log.append(d);
});

log.scrollTop=log.scrollHeight;
});
}

init();

</script>
</body>
</html>
